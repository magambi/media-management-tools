# Modify example values below.
@{

    # Configuration for Audiobookshelf API
    # The URL for Audiobookshelf
    AbsUrl = "http://localhost:13378"

    # A library ID from $AbsUrl/audiobookshelf/library/<ID>
    AbsLibraryId = "a1b2c3d4-1234-abcd-5678-abcdefabcdef"

    # An Audiobookshelf API token created from Settings > API Keys
    AbsApiToken = "a1b2c3d4-long-api-key-created-from-ABS"


    # Configuration for New York Times API
    # Obtain an NYT API key from https://developer.nytimes.com/
    NytApiKey = "a1b2c3d4-Api.key.from.NYT.dev"

}
